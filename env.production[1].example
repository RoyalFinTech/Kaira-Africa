# Kaira Africa API Server — PRODUCTION environment
# All values below marked (required) MUST be set or the process will
# refuse to start — see src/config/env.ts, which enforces this via a
# stricter Zod schema when NODE_ENV=production.

NODE_ENV=production
PORT=3000

# (required) Prefer a pooled connection for normal traffic.
DATABASE_URL=postgres://user:password@db-pooler.example.com:6543/postgres
# (required if DATABASE_URL is pooled) Direct, non-pooled connection —
# Drizzle migrations must run against this, not the pooler.
DIRECT_URL=postgres://user:password@db.example.com:5432/postgres

API_BASE_URL=https://api.kairaafrica.com
WEB_BASE_URL=https://app.kairaafrica.com
FRONTEND_URL=https://app.kairaafrica.com
BACKEND_URL=https://api.kairaafrica.com

# (required) Generate distinct values with: openssl rand -hex 32
# Rotate these on a schedule; rotating SESSION_SECRET invalidates all
# existing sessions (see lib/tokens.ts), so plan a rotation window.
JWT_SECRET=
SESSION_SECRET=
OTP_SECRET=
PASSWORD_RESET_SECRET=

# (required) Seeds the first super_admin account on deploy —
# see scripts/seed-admin.ts. Rotate the password immediately after
# first login via POST /auth/change-password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# (required) Managed Redis instance — used for distributed rate
# limiting across all API server replicas.
REDIS_URL=

# (required) Transactional email provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kaira Africa <no-reply@kairaafrica.com>"

# (required to actually deliver OTPs — SMS_PROVIDER=mock will run but
# does not send real SMS, appropriate only for staging)
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_SENDER_ID=KairaAfrica

# Optional — only needed if a feature calls the Supabase client SDK
# directly (Storage, etc). DATABASE_URL above is what connects the API
# to Supabase's Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=info
