# Kaira Africa Frontend — environment variables
# Copy to .env and fill in real values. Vite only exposes variables
# prefixed with VITE_ to client-side code — see src/lib/api-client.ts.

# Base URL of the Kaira Africa API server (see
# artifacts/api-server/.env.example for the backend's own config).
# Local dev default (if unset): http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Development authentication testing only — set false for production
VITE_AUTH_DEV_MODE=true
