# Kaira Africa API Server — DEVELOPMENT environment
# Everything below is safe to run locally with minimal setup:
# - OTPs print to the server console / are returned in the response
#   as `devOtp` (see routes/auth.ts) instead of sending real SMS.
# - Password resets behave the same way via `devResetToken`.
# - Redis/SMTP/SMS credentials are NOT required in development — the
#   app degrades gracefully (in-memory rate limiting if Redis is
#   unreachable, mock SMS/email providers).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/kaira_dev
DIRECT_URL=

API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Optional in development — if unset, a fixed dev-only fallback pepper
# is used (see lib/tokens.ts / lib/otp.ts). Set these to anything for
# more realistic local testing.
JWT_SECRET=dev-only-jwt-secret-change-me-please-32chars
SESSION_SECRET=dev-only-session-secret-change-me-32chars
OTP_SECRET=dev-only-otp-secret
PASSWORD_RESET_SECRET=dev-only-reset-secret

ADMIN_SEED_EMAIL=admin@kairaafrica.test
ADMIN_SEED_PASSWORD=Kaira#Admin2026!

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Optional in development — omit entirely to use the in-memory rate
# limiter fallback (see lib/redis.ts).
REDIS_URL=redis://localhost:6379

# Optional in development — omit to use the console-logging mock email
# transport (see services/email.service.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kaira Africa Dev <no-reply@kairaafrica.local>"

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=KairaDev

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=debug
