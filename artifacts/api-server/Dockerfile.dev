# Kaira Africa API Server — development image
#
# Optimized for fast local iteration (hot reload via `tsx watch`), not
# for production use. See Dockerfile for the production build.
# Intended to be used with docker-compose.yml, which mounts the repo
# as a volume so source edits are picked up without rebuilding the
# image — this Dockerfile only needs to be rebuilt when dependencies
# change.

FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /repo

# Native build tools for argon2's node-gyp-build fallback, in case a
# prebuilt binary isn't available for this exact platform/arch.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Full install (including devDependencies — tsx, drizzle-kit, etc are
# needed for local dev). pnpm-workspace.yaml's `allowBuilds` section
# approves argon2/esbuild's native builds non-interactively.
RUN pnpm install --frozen-lockfile

# Declaration files for the Drizzle/Zod workspace packages so
# api-server's TS imports of @workspace/db / @workspace/api-zod
# resolve correctly before the first `tsx watch` run.
RUN pnpm run typecheck:libs

WORKDIR /repo/artifacts/api-server
ENV NODE_ENV=development

EXPOSE 3000

CMD ["npx", "tsx", "watch", "src/index.ts"]
